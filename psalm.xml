<?xml version="1.0"?>
<psalm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://getpsalm.org/schema/config" errorLevel="3" hideExternalErrors="true" xsi:schemaLocation="https://getpsalm.org/schema/config https://getpsalm.org/schema/config" findUnusedCode="false" findUnusedBaselineEntry="false">
<projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="src/Resources/contao/dca"/>
            <directory name="src/Resources/contao/languages"/>
            <file name="src/DependencyInjection/Configuration.php"/>
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <UndefinedClass>
            <errorLevel type="suppress">
                <!-- Remove when dropping Contao 4.13 support -->
                <referencedClass name="Symfony\Component\Security\Core\Security"/>
            </errorLevel>
        </UndefinedClass>
    </issueHandlers>

    <universalObjectCrates>
        <class name="Contao\Database\Result"/>
    </universalObjectCrates>
</psalm>
